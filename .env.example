# Neon Postgres（Vercel Marketplace連携時は自動設定）
DATABASE_URL="postgresql://..."

# Resend（Vercel Marketplace連携時は自動設定）
RESEND_API_KEY="re_..."
EMAIL_FROM="澄屋 <notification@example.com>"
ADMIN_NOTIFICATION_EMAIL="owner@example.com"

# 管理画面認証
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="十分に長いランダムなパスワード"
ADMIN_SESSION_SECRET="32文字以上のランダム文字列"

# 通知メール内の管理画面リンク（本番サイトURL）
APP_URL="https://example.com"
